# Copy to .env and adjust. Connection string format:
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/setfuel
# Nix local cluster (see docs/nix.md): trust auth on localhost, no password:
# DATABASE_URL=postgresql://postgres@127.0.0.1:5432/setfuel

PORT=3001

# Auth — generate with: openssl rand -hex 64
JWT_SECRET=change-me-to-a-long-random-secret

# Google OAuth Web Client ID from https://console.cloud.google.com
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
