# Copy to `.env` in this folder. Restart Expo (Metro) after changes.
# Docs: https://docs.expo.dev/guides/environment-variables/

# Backend root URL (must include `/v1`, no trailing slash). Pick one for where you run the app:
#
#   iOS Simulator     → http://localhost:3001/v1
#   Android Emulator  → http://10.0.2.2:3001/v1   (localhost inside the emulator is the VM, not your Mac)
#   Physical device   → http://<your-computer-LAN-IP>:3001/v1   (same Wi‑Fi as the phone)
#
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001/v1

# true = mock/local data only. false = call API at EXPO_PUBLIC_API_BASE_URL
EXPO_PUBLIC_USE_LOCAL=true
